<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.title }}</title>
<meta name="description" content="{{ site.description }}">
<meta name="color-scheme" content="dark">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/log.css' | url }}">
</head>
<body>

<div class="wrap">
  <header class="masthead">
    <a class="home" href="{{ '/' | url }}">{{ site.title }}</a>
    <span>{{ collections.entries | length }} entries</span>
    <a href="{{ '/about/' | url }}">about</a>
    {% if site.tagline %}<em class="tag">{{ site.tagline }}</em>{% endif %}
  </header>

  {{ content | safe }}
</div>

<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <div class="lb-bar">
    <span class="file" id="lbFile"></span>
    <span id="lbDims"></span>
    <span class="count" id="lbCount"></span>
    <button class="lb-close" id="lbClose">close &#10005;</button>
  </div>
  <div class="lb-stage" id="lbStage">
    <button class="lb-nav lb-prev" id="lbPrev" aria-label="Previous photo">&#8592;</button>
    <img class="lb-img" id="lbImg" alt="">
    <button class="lb-nav lb-next" id="lbNext" aria-label="Next photo">&#8594;</button>
  </div>
  <div class="lb-foot">
    <span class="cap" id="lbCap"></span>
    <span class="keys">&#8592; &#8594; to move &middot; esc to close</span>
  </div>
</div>

<script src="{{ '/lightbox.js' | url }}" defer></script>
</body>
</html>
